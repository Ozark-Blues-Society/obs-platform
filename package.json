{
  "name": "obs-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Ozark Blues Society website, membership and email platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:db": "supabase test db",
    "fixtures:generate": "node scripts/fixtures/generate.mts",
    "email:preview": "email dev --dir emails --port 3030",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "next": "16.4.6",
    "next-sanity": "13.5.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "6.11.16",
    "sanity": "6.25.0",
    "styled-components": "6.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@react-email/ui": "6.11.16",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.23.0"
}
