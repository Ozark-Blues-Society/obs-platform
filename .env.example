# Environment variables for the Next.js app. Copy this file to .env.local (git-ignored) and adjust.
# Never commit real secrets. Backlog F-4 adds typed validation and the rest of the keys.

# Supabase (backlog M-1). These are the local stack's well-known demo values, the same on every
# machine (`supabase status` prints them), so they're not secrets. Hosted projects use their own.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# The service role's secret key, for server code that acts for the Society rather than a member,
# such as the daily jobs (backlog E-2). It bypasses row level security: a secret, server-only,
# never NEXT_PUBLIC_. Locally, copy SECRET_KEY from `supabase status`.
SUPABASE_SECRET_KEY=

# Sanity (backlog F-5): the Content Studio at /studio and the site's content. Leave these empty
# until a Sanity project exists (creating one is a human gate): the app then uses a placeholder
# project ID, so /studio shows "Project not found" and no content loads. See the README.
# The project ID and dataset name aren't secrets. Locally, always use the development dataset.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=development
# A Viewer token for the project. A secret, server-only: never rename it to NEXT_PUBLIC_. The
# datasets are private (decision 0001), so reading content and turning on previews both need it.
SANITY_API_READ_TOKEN=

# The site's own address, for the links in emails. Production: https://<Society domain>.
SITE_URL=http://localhost:3000

# Email (lib/email/send.ts). Every email leaves from EMAIL_FROM, a bare address, with the name
# "Ozark Blues Society" (decision 0005): noreply@mail.<Society domain> in production,
# onboarding@resend.dev with a Resend test key. With RESEND_API_KEY set, emails go through Resend;
# without it they go to Mailpit at MAILPIT_URL (the local stack's, see the README), so locally
# nothing leaves this machine.
EMAIL_FROM=onboarding@resend.dev
RESEND_API_KEY=
MAILPIT_URL=http://127.0.0.1:54324

# The daily jobs (backlog E-2, decision 0006): the secret that Netlify's scheduled function sends to
# /api/cron/daily. Empty means the jobs are off. Set any value locally to run them by hand (see
# "Daily jobs" in the README); production needs a long random one.
CRON_SECRET=
