# Environment variables for the app. Copy this file to .env.local (git-ignored) and fill it in.
# lib/env checks every variable when the app builds or starts and names any that's wrong (never its
# value). An empty value means unset, which turns that feature off. Never commit a real secret, and
# never give one a NEXT_PUBLIC_ name: those values reach every visitor's browser. Each variable has
# a one-line note above it; see "Environment variables" in the README for the rest.

# Supabase (backlog M-1): sign-in, member data and files. The two NEXT_PUBLIC_ values below are the
# local stack's well-known demo values, the same on every machine and not secrets; hosted projects
# have their own. Set both or neither: without them the public pages work, but nobody can sign in.
# The Supabase API's address (`supabase status` prints it as API_URL).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# The publishable key, which browsers use (`supabase status`: PUBLISHABLE_KEY).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# Secret: the service role key, for the daily jobs and emails (`supabase status`: SECRET_KEY).
SUPABASE_SECRET_KEY=

# Sanity (backlog F-5): the Content Studio at /studio and the site's content. Leave the project ID
# and the token empty until the Society's Sanity project exists (a human gate): the app then uses a
# placeholder project ID, /studio shows "Project not found", and no content loads.
# The project's ID, from sanity.io/manage. Not a secret.
NEXT_PUBLIC_SANITY_PROJECT_ID=
# The dataset. Not a secret. Locally, always development, never production.
NEXT_PUBLIC_SANITY_DATASET=development
# Secret: a Viewer token. The datasets are private (decision 0001), so reading content needs it.
SANITY_API_READ_TOKEN=
# Tests only: Playwright points the app at its local stand-in for Sanity's API. Leave it empty.
SANITY_API_HOST_STAND_IN=

# The site's own address, for the links in emails. Production: https://<Society domain>.
SITE_URL=http://localhost:3000

# Email (lib/email/send.ts). Every email leaves from EMAIL_FROM with the name "Ozark Blues Society"
# (decision 0005). With RESEND_API_KEY set, emails go through Resend; without it they go to Mailpit
# at MAILPIT_URL, so locally nothing leaves this machine.
# The bare sender address: noreply@mail.<Society domain> in production; this one locally.
EMAIL_FROM=onboarding@resend.dev
# Secret: a Resend API key. Leave it empty locally.
RESEND_API_KEY=
# The local stack's Mailpit, which catches the emails (an address on this machine only).
MAILPIT_URL=http://127.0.0.1:54324

# The daily jobs (backlog E-2, decision 0006): Netlify's scheduled function calls /api/cron/daily
# with this secret. Empty means the jobs are off. Locally, any value lets you run them by hand (see
# "Daily jobs" in the README); production needs a long random one.
# Secret: the daily jobs' shared secret.
CRON_SECRET=

# MailerLite: the member group sync (backlog E-3), the blog's newsletter signup (decision 0015) and
# the email switches on My Account (decision 0016). Empty means all three are off. Leave it empty
# locally and in CI: the tests use a stand-in for MailerLite's API, and a real key would put the
# synthetic fixture members into a real account.
# Secret: a MailerLite API token (production: from the Society's account, see the README).
MAILERLITE_API_KEY=
# Tests only: Playwright points the app at its local stand-in for MailerLite's API. Leave it empty.
MAILERLITE_API_URL_STAND_IN=

# Zeffy (backlog M-3, decision 0007): membership payments, tickets and donations. Zeffy has no test
# mode, so both stay empty here, on the factory server and in CI; a human sets them on Netlify
# staging and production only. The tests use fixtures from the API spec snapshot (docs/vendor/).
# Secret: the organization's API key (Zeffy: Settings > Integrations). Empty means no API calls.
ZEFFY_API_KEY=
# Secret: the webhook signing secret from the same dialog, whsec_...
ZEFFY_WEBHOOK_SECRET=
